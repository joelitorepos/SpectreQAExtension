{
  "manifest_version": 3,
  "name": "SpectreQA",
  "version": "1.0.1",
  "description": "Extensión para testear aplicaciones web locales y en producción.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*",
    "http://localhost/*",
    "ws://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SpectreQA",
    "default_popup": "popup.html"
  }
}